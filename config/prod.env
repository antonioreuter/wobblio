# ─── Wobblio — prod environment ───────────────────────────────────────────────
# Non-sensitive configuration for the production AWS stage.
# Sensitive values (DB credentials, Stripe keys) live in AWS Secrets Manager
# and are fetched at runtime by the bootstrap/deploy scripts.
# Usage: sourced automatically by scripts/bootstrap-aws.sh and scripts/deploy-aws.sh.

# ── Stage ─────────────────────────────────────────────────────────────────────
STAGE=prod

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_PROFILE=reuterAdmin
CDK_DEFAULT_REGION=eu-west-1

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=wobblio_prod
DB_SSL=true
# DB_HOST, DB_USER, DB_PASSWORD fetched from Secrets Manager at runtime

# ── Domains ───────────────────────────────────────────────────────────────────
APP_DOMAIN=app.wobblio.com
API_DOMAIN=api.wobblio.com
NEXT_PUBLIC_API_BASE_URL=https://api.wobblio.com
NEXT_PUBLIC_SITE_URL=https://app.wobblio.com

# ── S3 buckets ────────────────────────────────────────────────────────────────
S3_UPLOADS_BUCKET=wobblio-uploads-prod
S3_EXPORTS_BUCKET=wobblio-exports-prod
S3_BILLING_ARCHIVE_BUCKET=wobblio-billing-archive-prod
S3_ANALYTICS_BUCKET=wobblio-analytics-prod

# ── Bedrock model IDs ─────────────────────────────────────────────────────────
MODEL_VISION_PARSER=amazon.nova-lite-v1:0
MODEL_AUXILIARY=anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_INSIGHT=anthropic.claude-sonnet-4-6-v1:0
MODEL_EMBEDDER=amazon.titan-embed-text-v2:0

# ── Quotas ────────────────────────────────────────────────────────────────────
QUOTA_STANDARD_UPLOADS_PER_WEEK=3
QUOTA_PREMIUM_UPLOADS_PER_WEEK=10
QUOTA_HOUSEHOLD_UPLOADS_PER_WEEK=20
QUOTA_MAX_FREE_WAITLIST_CAP=5000

# ── Routing ───────────────────────────────────────────────────────────────────
ROUTING_MAX_STORES=3
ROUTING_MIN_SPLIT_SAVING_EUR=5.00

# ── AI ────────────────────────────────────────────────────────────────────────
AI_DAILY_SPEND_CAP=0.10
TAGS_DEDICATED_CALL_ENABLED=false
TAGS_VOCABULARY=[]

# ── Observability ─────────────────────────────────────────────────────────────
OPS_EMAIL=antonioreuter@gmail.com
BUDGET_LIMIT_EUR=30
COST_ANOMALY_THRESHOLD_EUR=10

# ── Billing ───────────────────────────────────────────────────────────────────
# No mock premium whitelist in production
BILLING_MOCK_PREMIUM_WHITELIST=-
WEB_APP_URL=https://app.wobblio.com
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET fetched from Secrets Manager at runtime
