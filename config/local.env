# ─── Wobblio — local environment ──────────────────────────────────────────────
# All services run on your machine via Docker. No AWS credentials required.
# This file is committed; it contains only Docker-fixed mock credentials.
# Usage: sourced automatically by scripts/bootstrap-local.sh and make deploy.

# ── Stage ─────────────────────────────────────────────────────────────────────
STAGE=local

# ── AWS (LocalStack) ──────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566

# ── Database (Docker Postgres) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wobblio_local
DB_USER=wobblio_dev
DB_PASSWORD=wobblio_dev_secret
DB_SSL=false
DATABASE_URL=postgres://wobblio_dev:wobblio_dev_secret@localhost:5432/wobblio_local

# ── Domains ───────────────────────────────────────────────────────────────────
APP_DOMAIN=localhost:3000
API_DOMAIN=localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── S3 buckets ────────────────────────────────────────────────────────────────
S3_UPLOADS_BUCKET=wobblio-uploads-local
S3_EXPORTS_BUCKET=wobblio-exports-local
S3_BILLING_ARCHIVE_BUCKET=wobblio-billing-archive-local
S3_ANALYTICS_BUCKET=wobblio-analytics-local

# ── SQS queues ────────────────────────────────────────────────────────────────
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/wobblio-ingestion-local
SQS_INGESTION_DLQ_URL=http://localhost:4566/000000000000/wobblio-ingestion-dlq-local
SQS_ANALYTICS_QUEUE_URL=http://localhost:4566/000000000000/wobblio-analytics-events-local

# ── Bedrock model IDs (mock — not called locally; unit tests mock the port) ───
MODEL_VISION_PARSER=mock-vision-model
MODEL_AUXILIARY=mock-auxiliary-model
MODEL_INSIGHT=mock-insight-model
MODEL_EMBEDDER=mock-embedder-model

# ── Ingestion (canonical Lambda env names; mirror what CDK injects on AWS) ─────
UPLOADS_BUCKET=wobblio-uploads-local
INGEST_QUEUE_URL=http://localhost:4566/000000000000/wobblio-ingestion-local

# ── Local AI: Ollama stands in for Bedrock (real vision parse, same port) ─────
# Default Ollama port is 11434 — adjust if the address below cannot connect.
OLLAMA_BASE_URL=http://192.168.86.86:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
# Embeddings model (pull on the Ollama host: `ollama pull nomic-embed-text`).
# 768-dim output is truncated to 512 by OllamaEmbedderAdapter for the vector(512) column.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Context window for local vision parsing — receipt images exceed Ollama's 4096 default.
OLLAMA_NUM_CTX=16384

# ── Quotas ────────────────────────────────────────────────────────────────────
QUOTA_STANDARD_UPLOADS_PER_WEEK=3
QUOTA_PREMIUM_UPLOADS_PER_WEEK=10
QUOTA_HOUSEHOLD_UPLOADS_PER_WEEK=20
QUOTA_MAX_FREE_WAITLIST_CAP=5000

# ── Routing ───────────────────────────────────────────────────────────────────
ROUTING_MAX_STORES=3
ROUTING_MIN_SPLIT_SAVING_EUR=5.00

# ── AI ────────────────────────────────────────────────────────────────────────
AI_DAILY_SPEND_CAP=0.10
TAGS_DEDICATED_CALL_ENABLED=false
TAGS_VOCABULARY=[]

# ── Observability ─────────────────────────────────────────────────────────────
OPS_EMAIL=antonioreuter@gmail.com
BUDGET_LIMIT_EUR=10
COST_ANOMALY_THRESHOLD_EUR=3

# ── Cognito (cognito-local) ───────────────────────────────────────────────────
COGNITO_ENDPOINT=http://localhost:9229
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=local_7Sc5wz89
COGNITO_CLIENT_ID=d75hrfoxj6341cqxcz99k2xj7
COGNITO_CLIENT_SECRET=

# ── NextAuth ──────────────────────────────────────────────────────────────────
AUTH_SECRET=dev-secret-local-only-change-in-prod
NEXTAUTH_URL=http://localhost:3000

# ── Billing ───────────────────────────────────────────────────────────────────
# Comma-separated Cognito sub UUIDs granted premium locally; use email for dev convenience
BILLING_MOCK_PREMIUM_WHITELIST=antonioreuter@gmail.com
WEB_APP_URL=http://localhost:3000

# ── Stripe (mock — seeded into LocalStack Secrets Manager) ───────────────────
STRIPE_SECRET_KEY=sk_test_mock_local
STRIPE_WEBHOOK_SECRET=whsec_mock_local
