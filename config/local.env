# ─── Wobblio — local environment ──────────────────────────────────────────────
# All services run on your machine via Docker, except Bedrock: it has no LocalStack
# equivalent, so AI calls hit real AWS using the AWS_PROFILE below (valid AWS
# credentials required for that profile). This file is committed; it contains only
# Docker-fixed mock credentials plus a profile name.
# Usage: sourced automatically by scripts/bootstrap-local.sh and make deploy.

# ── Stage ─────────────────────────────────────────────────────────────────────
STAGE=local

# ── AWS (LocalStack) ──────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
# cdklocal strips every non-allowlisted AWS_* var from the CDK child env and then
# defaults AWS_REGION to us-east-1 — which would strand SQS/Secrets (region-isolated)
# away from the eu-west-1 app. Allowlist the region vars so eu-west-1 is preserved.
AWS_DEFAULT_REGION=eu-west-1
AWS_ENVAR_ALLOWLIST=AWS_REGION,AWS_DEFAULT_REGION
AWS_ENDPOINT_URL=http://localhost:4566
# Modern AWS CDK / cdklocal refuses to run if AWS_ENDPOINT_URL is set without an
# explicit S3 endpoint. Point it at the same LocalStack gateway.
AWS_ENDPOINT_URL_S3=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
# Real AWS profile used ONLY by the Bedrock client (buildBedrockRuntimeClient).
# LocalStack clients keep the fake test creds above; Bedrock loads this profile
# from ~/.aws so local AI runs against the same models as the dev account.
AWS_PROFILE=reuterAdmin
# Outside Lambda, aws-embedded-metrics defaults to the CloudWatch-agent TCP sink
# (0.0.0.0:25888) and throws when no agent is listening — which would fail the
# Bedrock converse path locally. 'Local' writes EMF to stdout instead.
AWS_EMF_ENVIRONMENT=Local

# ── Database (Docker Postgres) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wobblio_local
DB_USER=wobblio_dev
DB_PASSWORD=wobblio_dev_secret
DB_SSL=false
DATABASE_URL=postgres://wobblio_dev:wobblio_dev_secret@localhost:5432/wobblio_local
# App runtime connects as a non-owner, non-superuser role so Row-Level Security is
# actually enforced (the owner DATABASE_URL above bypasses RLS — kept for migrations
# and seeds only). Created by scripts/local/deploy.sh.
APP_DATABASE_URL=postgres://wobblio_app:wobblio_app_secret@localhost:5432/wobblio_local

# ── Domains ───────────────────────────────────────────────────────────────────
APP_DOMAIN=localhost:3000
API_DOMAIN=localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin of presigned receipt PUT/GET URLs — must be in the webapp CSP
# (connect-src for upload, img-src for display). Path-style LocalStack locally;
# the bucket's S3 virtual-hosted origin on AWS.
NEXT_PUBLIC_UPLOADS_BUCKET_ORIGIN=http://localhost:4566
UPLOADS_BUCKET_ORIGIN=http://localhost:4566

# ── S3 buckets ────────────────────────────────────────────────────────────────
S3_UPLOADS_BUCKET=wobblio-uploads-local
S3_EXPORTS_BUCKET=wobblio-exports-local
S3_BILLING_ARCHIVE_BUCKET=wobblio-billing-archive-local
S3_ANALYTICS_BUCKET=wobblio-analytics-local

# ── SQS queues ────────────────────────────────────────────────────────────────
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/wobblio-ingestion-local
SQS_INGESTION_DLQ_URL=http://localhost:4566/000000000000/wobblio-ingestion-dlq-local
SQS_ANALYTICS_QUEUE_URL=http://localhost:4566/000000000000/wobblio-analytics-events-local

# ── Bedrock model IDs (real — same as the dev account; seeded into LocalStack SSM
#    by the bootstrap, which is what the worker/cron actually read at runtime).
#    Vision = Qwen3-VL (invokable on-demand by foundation-model ID, no profile).
#    Claude models use eu.* cross-region inference profiles — not invokable
#    on-demand by bare foundation-model ID in eu-west-1. ────────────────────────
MODEL_VISION_PARSER=qwen.qwen3-vl-235b-a22b
MODEL_AUXILIARY=eu.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_INSIGHT=eu.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_EMBEDDER=amazon.titan-embed-text-v2:0

# ── Ingestion (canonical Lambda env names; mirror what CDK injects on AWS) ─────
UPLOADS_BUCKET=wobblio-uploads-local
INGEST_QUEUE_URL=http://localhost:4566/000000000000/wobblio-ingestion-local

# ── Quotas ────────────────────────────────────────────────────────────────────
QUOTA_STANDARD_UPLOADS_PER_WEEK=3
QUOTA_PREMIUM_UPLOADS_PER_WEEK=10
QUOTA_HOUSEHOLD_UPLOADS_PER_WEEK=20
QUOTA_MAX_FREE_WAITLIST_CAP=5000

# ── Routing ───────────────────────────────────────────────────────────────────
ROUTING_MAX_STORES=3
ROUTING_MIN_SPLIT_SAVING_EUR=5.00

# ── AI ────────────────────────────────────────────────────────────────────────
AI_DAILY_SPEND_CAP=0.10
TAGS_DEDICATED_CALL_ENABLED=false
TAGS_VOCABULARY=[]

# ── Observability ─────────────────────────────────────────────────────────────
OPS_EMAIL=antonioreuter@gmail.com
BUDGET_LIMIT_EUR=10
COST_ANOMALY_THRESHOLD_EUR=3

# ── Cognito (cognito-local) ───────────────────────────────────────────────────
COGNITO_ENDPOINT=http://localhost:9229
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=local_7UZgDBOv
COGNITO_CLIENT_ID=duphvn98s7b7cs7z0cg2ot3ot
COGNITO_CLIENT_SECRET=

# ── NextAuth ──────────────────────────────────────────────────────────────────
AUTH_SECRET=dev-secret-local-only-change-in-prod
NEXTAUTH_URL=http://localhost:3000

# ── Billing ───────────────────────────────────────────────────────────────────
# Comma-separated Cognito sub UUIDs granted premium locally; use email for dev convenience
BILLING_MOCK_PREMIUM_WHITELIST=antonioreuter@gmail.com
WEB_APP_URL=http://localhost:3000

# ── Stripe (mock — seeded into LocalStack Secrets Manager) ───────────────────
STRIPE_SECRET_KEY=sk_test_mock_local
STRIPE_WEBHOOK_SECRET=whsec_mock_local

# Verbose logging for local debugging — surfaces the full parsed-receipt JSON
LOG_LEVEL=debug
