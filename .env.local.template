# Copy this file to .env.local and fill in any blanks.
# .env.local is gitignored — never commit real secrets.

# ── Stage ────────────────────────────────────────────────────────────────────
STAGE=local

# ── AWS (LocalStack fake credentials — any non-empty string works) ──────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
# cdklocal v3+ requires this alongside AWS_ENDPOINT_URL
AWS_ENDPOINT_URL_S3=http://localhost:4566

# ── LocalStack ────────────────────────────────────────────────────────────────
LOCALSTACK_ENDPOINT=http://localhost:4566
# Optional: fill in if you have a LocalStack Pro account (enables Resource Browser)
LOCALSTACK_AUTH_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=wobblio_dev
POSTGRES_PASSWORD=wobblio_dev_secret
POSTGRES_DB=wobblio_local
# Use 'localhost' from host machine; use 'postgres' from inside Lambda containers
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wobblio_local
DB_USER=wobblio_dev
DB_PASSWORD=wobblio_dev_secret
DB_SSL=false
DATABASE_URL=postgres://wobblio_dev:wobblio_dev_secret@localhost:5432/wobblio_local

# ── Cognito local ─────────────────────────────────────────────────────────────
COGNITO_ENDPOINT=http://localhost:9229
COGNITO_USER_POOL_ID=local_test_pool
COGNITO_CLIENT_ID=local_test_client

# ── Bedrock mock ──────────────────────────────────────────────────────────────
BEDROCK_ENDPOINT=http://localhost:4577
# Float 0.0–1.0: probability of returning a 500 error (for DLQ path testing)
BEDROCK_ERROR_INJECTION_RATE=0

# ── S3 bucket names ───────────────────────────────────────────────────────────
S3_UPLOADS_BUCKET=wobblio-uploads-local
S3_EXPORTS_BUCKET=wobblio-exports-local
S3_BILLING_ARCHIVE_BUCKET=wobblio-billing-archive-local
S3_ANALYTICS_BUCKET=wobblio-analytics-local

# ── SQS queue URLs ────────────────────────────────────────────────────────────
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/wobblio-ingestion-local
SQS_INGESTION_DLQ_URL=http://localhost:4566/000000000000/wobblio-ingestion-dlq-local

# ── Stripe (mock values for local — never use real keys here) ────────────────
STRIPE_SECRET_KEY=sk_test_mock_local
STRIPE_WEBHOOK_SECRET=whsec_mock_local
